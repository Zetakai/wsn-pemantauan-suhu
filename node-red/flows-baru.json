    {
        "id": "n_mqtt",
        "type": "mqtt in",
        "z": "tab_flow_wsn",
        "name": "Terima Data WSN",
        "topic": "itts-wsn-kelompok2/node/+",
        "qos": "0",
        "datatype": "json",
        "broker": "broker_hivemq",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 130,
        "y": 160,
        "wires": [
            [
                "n_norm"
            ]
        ]
    },
    {
        "id": "n_norm",
        "type": "function",
        "z": "tab_flow_wsn",
        "name": "Ubah format gateway",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 170,
        "y": 220,
        "wires": [
            [
                "n_csv_fn",
                "n_alert_fn",
                "n_switch"
            ]
        ],
        "func": "// Gateway/Wokwi mengirim {node, seq, suhu, kelembapan, status, ...}.\n// Flow ini memakai {node_id, seq, temp, hum}.\nconst p = msg.payload;\nif (!p || p.status !== 0 || typeof p.suhu !== 'number') return null; // lewati paket sensor gagal\nmsg.payload = { node_id: Number(p.node), seq: p.seq, temp: p.suhu, hum: p.kelembapan };\nreturn msg;"
    },
    {
        "id": "n_inject",
        "type": "inject",
        "z": "tab_flow_wsn",
        "name": "Simulasi Ruang 2 (Alert)",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "{\"node_id\":2,\"temp\":29.5,\"hum\":76,\"seq\":1}",
        "payloadType": "json",
        "x": 150,
        "y": 80,
        "wires": [
            [
                "n_csv_fn",
                "n_alert_fn",
                "n_switch"
            ]
        ]
    },
    {
        "id": "n_csv_fn",
        "type": "function",
        "z": "tab_flow_wsn",
        "name": "Format CSV",
        "outputs": 1,
        "noerr": 0,
        "timeout": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 80,
        "wires": [
            [
                "n_file"
            ]
        ],
        "func": "const d = msg.payload;\nconst ts = new Date().toISOString();\nmsg.payload = `${ts},${d.node_id},${d.seq},${d.temp},${d.hum}`;\nreturn msg;"
    },
    {
        "id": "n_file",
        "type": "file",
        "z": "tab_flow_wsn",
        "name": "Simpan log_wsn.csv",
        "filename": "log_wsn.csv",
        "filenameType": "str",
        "appendNewline": true,
        "createDir": true,
        "overwriteFile": "false",
        "encoding": "none",
        "x": 620,
        "y": 80,
        "wires": [
            []
        ]
    },
    {
        "id": "n_alert_fn",
        "type": "function",
        "z": "tab_flow_wsn",
        "name": "Cek Ambang Batas",
        "outputs": 1,
        "noerr": 0,
        "timeout": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 140,
        "wires": [
            [
                "n_tg"
            ]
        ],
        "func": "const d = msg.payload;\nconst bahaya = d.temp > 30 || d.hum > 70;\n\n// Kirim hanya saat ruangan BERUBAH dari normal ke bahaya (bukan tiap paket).\nconst status = flow.get('statusAlert') || {};\nconst sebelumnya = status[d.node_id] || false;\nstatus[d.node_id] = bahaya;\nflow.set('statusAlert', status);\nif (!bahaya || sebelumnya) return null;\n\nconst token = env.get('TELEGRAM_TOKEN');\nconst chatId = env.get('TELEGRAM_CHAT_ID');\nif (!token || !chatId) {\n    node.status({ fill: 'yellow', shape: 'ring', text: 'TELEGRAM_TOKEN / TELEGRAM_CHAT_ID belum diisi (.env)' });\n    return null;\n}\nmsg.url = 'https://api.telegram.org/bot' + token + '/sendMessage';\nmsg.headers = { 'Content-Type': 'application/json' };\nmsg.payload = {\n    chat_id: chatId,\n    text: `⚠️ PERINGATAN WSN (Ruangan ${d.node_id})\\nSuhu: ${d.temp} °C\\nKelembapan: ${d.hum} %\\nPaket #${d.seq}`\n};\nreturn msg;"
    },
    {
        "id": "n_tg",
        "type": "http request",
        "z": "tab_flow_wsn",
        "name": "Kirim Telegram",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 620,
        "y": 140,
        "wires": [
            []
        ]
    },
    {
        "id": "n_switch",
        "type": "switch",
        "z": "tab_flow_wsn",
        "name": "Pilih Ruangan",
        "property": "payload.node_id",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "1",
                "vt": "num"
