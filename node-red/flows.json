    {
        "id": "f002800000000000",
        "type": "function",
        "z": "a1b2c3d4e5f60001",
        "name": "Cek ambang batas",
        "func": "// Kirim peringatan hanya saat kondisi BERUBAH (normal -> melewati ambang, atau sebaliknya),\n// supaya Telegram tidak dibanjiri pesan setiap 5 menit. Histeresis mencegah pesan bolak-balik.\nconst HIST_SUHU = 0.5, HIST_HUM = 2;\nconst d = msg.payload;\nconst t = flow.get('ambang') || { suhuMax: 30, humMax: 70 };\nconst semua = flow.get('alertState') || {};\nconst lalu = semua[d.node] || { suhu: false, hum: false, sensor: false };\nconst kini = { ...lalu, sensor: !d.sensorOk };\nconst pesan = [];\n\nif (kini.sensor && !lalu.sensor) pesan.push('❗ ' + d.ruang + ': sensor DHT22 gagal dibaca');\nif (!kini.sensor && lalu.sensor) pesan.push('✅ ' + d.ruang + ': sensor kembali terbaca');\n\nif (d.sensorOk) {\n    kini.suhu = lalu.suhu ? d.suhu > t.suhuMax - HIST_SUHU : d.suhu > t.suhuMax;\n    kini.hum = lalu.hum ? d.kelembapan > t.humMax - HIST_HUM : d.kelembapan > t.humMax;\n    if (kini.suhu && !lalu.suhu) pesan.push('⚠️ ' + d.ruang + ': suhu ' + d.suhu + ' °C melewati batas ' + t.suhuMax + ' °C');\n    if (!kini.suhu && lalu.suhu) pesan.push('✅ ' + d.ruang + ': suhu kembali normal (' + d.suhu + ' °C)');\n    if (kini.hum && !lalu.hum) pesan.push('⚠️ ' + d.ruang + ': kelembapan ' + d.kelembapan + '% melewati batas ' + t.humMax + '%');\n    if (!kini.hum && lalu.hum) pesan.push('✅ ' + d.ruang + ': kelembapan kembali normal (' + d.kelembapan + '%)');\n}\nsemua[d.node] = kini;\nflow.set('alertState', semua);\nif (!pesan.length) return null;\nreturn { topic: d.ruang, payload: pesan.join('\\n') };",
