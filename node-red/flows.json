        "name": "Daftar peringatan",
        "order": 1,
        "width": 6,
        "height": 8,
        "format": "<div ng-if=\"!msg.payload.length\" style=\"opacity:.6\">Belum ada peringatan.</div>\n<table style=\"width:100%;border-collapse:collapse\">\n  <tr ng-repeat=\"a in msg.payload\" style=\"border-bottom:1px solid rgba(128,128,128,.2)\">\n    <td style=\"white-space:nowrap;opacity:.7;padding:4px 8px 4px 0;vertical-align:top\">{{a.waktu}}</td>\n    <td style=\"padding:4px 0\">{{a.teks}}</td>\n  </tr>\n</table>",
