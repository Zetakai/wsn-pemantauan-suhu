    {
        "id": "f003200000000000",
        "type": "function",
        "z": "a1b2c3d4e5f60001",
        "name": "Cek node offline",
        "func": "const RUANG = { 1: 'Ruang A', 2: 'Ruang B', 3: 'Ruang C', 4: 'Ruang D' };\n\n// Dicek tiap menit: node dianggap offline jika tidak mengirim data > BATAS_MENIT.\n// Node nyata mengirim tiap 5 menit, jadi 12 menit = 2 paket berturut-turut hilang.\nconst BATAS_MENIT = Number(env.get('WSN_OFFLINE_MENIT')) || 12;\nconst stats = flow.get('stats') || {};\nconst offline = flow.get('offline') || {};\nconst alerts = [];\nconst status = [null, null, null, null];\nfor (const id of [1, 2, 3, 4]) {\n    const s = stats[id];\n    if (!s) continue;                           // belum pernah mengirim\n    const mati = Date.now() - s.lastSeen > BATAS_MENIT * 60000;\n    if (mati && !offline[id]) {\n        alerts.push('📴 ' + RUANG[id] + ': node tidak mengirim data lebih dari ' + BATAS_MENIT + ' menit');\n        status[id - 1] = { payload: 'Offline' };\n    }\n    if (!mati && offline[id]) alerts.push('📶 ' + RUANG[id] + ': node kembali online');\n    offline[id] = mati;\n}\nflow.set('offline', offline);\nreturn [alerts.length ? { topic: 'offline', payload: alerts.join('\\n') } : null, ...status];",
