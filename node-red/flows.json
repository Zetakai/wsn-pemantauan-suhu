    {
        "id": "f002c00000000000",
        "type": "function",
        "z": "a1b2c3d4e5f60001",
        "name": "Ke widget ruang",
        "func": "const jam = (t) => new Date(t).toLocaleTimeString('id-ID', { timeZone: 'Asia/Jakarta' });\n\n// 5 keluaran per ruang: suhu, kelembapan, status, detail, waktu (urut Ruang A..D).\nconst d = msg.payload;\nconst t = flow.get('ambang') || { suhuMax: 30, humMax: 70 };\nlet status = 'Normal';\nif (!d.sensorOk) status = 'Sensor gagal dibaca';\nelse if (d.suhu > t.suhuMax && d.kelembapan > t.humMax) status = '⚠ Suhu & kelembapan tinggi';\nelse if (d.suhu > t.suhuMax) status = '⚠ Suhu tinggi';\nelse if (d.kelembapan > t.humMax) status = '⚠ Kelembapan tinggi';\n\nconst keluaran = new Array(20).fill(null);\nconst b = (d.node - 1) * 5;\nif (d.sensorOk) {\n    keluaran[b] = { payload: d.suhu };\n    keluaran[b + 1] = { payload: d.kelembapan };\n}\nkeluaran[b + 2] = { payload: status };\nkeluaran[b + 3] = { payload: '🔋 ' + d.vbat.toFixed(2) + ' V · PDR ' + d.pdr + '% · ' + d.rssi + ' dBm' };\nkeluaran[b + 4] = { payload: jam(d.waktu) + ' · #' + d.seq };\nreturn keluaran;",
