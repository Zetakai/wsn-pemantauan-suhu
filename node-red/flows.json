    {
        "id": "f002200000000000",
        "type": "function",
        "z": "a1b2c3d4e5f60001",
        "name": "Status Telegram",
        "func": "if (msg.statusCode === 200 && msg.payload && msg.payload.ok) {\n    node.status({ fill: 'green', shape: 'dot', text: 'terkirim ' + new Date().toLocaleTimeString('id-ID') });\n} else {\n    node.status({ fill: 'red', shape: 'ring', text: 'gagal: ' + (msg.payload && msg.payload.description || msg.statusCode) });\n    node.warn(msg.payload);\n}\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1290,
        "y": 1180,
        "wires": [
            []
        ]
    },
