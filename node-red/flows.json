    {
        "id": "f002400000000000",
        "type": "function",
        "z": "a1b2c3d4e5f60001",
        "name": "Format Telegram",
        "func": "const token = env.get('TELEGRAM_TOKEN');\nconst chat = env.get('TELEGRAM_CHAT_ID');\nif (!token || !chat) {\n    node.status({ fill: 'yellow', shape: 'ring', text: 'TELEGRAM_TOKEN / TELEGRAM_CHAT_ID belum diisi' });\n    return null;\n}\nmsg.method = 'POST';\nmsg.url = 'https://api.telegram.org/bot' + token + '/sendMessage';\nmsg.headers = { 'content-type': 'application/json' };\nmsg.payload = { chat_id: chat, text: '[WSN Kelompok 2]\\n' + msg.payload };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 850,
        "y": 1180,
        "wires": [
