    {
        "id": "f002e00000000000",
        "type": "function",
        "z": "a1b2c3d4e5f60001",
        "name": "Validasi & PDR",
        "func": "const RUANG = { 1: 'Ruang A', 2: 'Ruang B', 3: 'Ruang C', 4: 'Ruang D' };\n\n// Validasi paket dan hitung Packet Delivery Ratio (PDR) dari nomor urut (seq).\nconst p = msg.payload;\nif (typeof p !== 'object' || p === null) { node.warn('Payload bukan JSON: ' + msg.payload); return null; }\nconst id = Number(p.node);\nif (!RUANG[id]) { node.warn('Node tidak dikenal: ' + p.node); return null; }\nconst seq = Number(p.seq);\n\nconst stats = flow.get('stats') || {};\nlet s = stats[id];\n// seq turun = node restart (memori RTC hilang) -> mulai hitung ulang\nif (!s || seq < s.last) s = { first: seq, last: seq - 1, diterima: 0, duplikat: 0 };\nif (seq === s.last) {            // paket ulang (ACK hilang, node kirim lagi)\n    s.duplikat++;\n    stats[id] = s; flow.set('stats', stats);\n    return null;\n}\ns.diterima++;\ns.last = seq;\ns.lastSeen = Date.now();\nstats[id] = s;\nflow.set('stats', stats);\n\nconst sensorOk = Number(p.status) === 0 && typeof p.suhu === 'number' && typeof p.kelembapan === 'number';\nmsg.payload = {\n    node: id,\n    ruang: RUANG[id],\n    suhu: sensorOk ? Math.round(p.suhu * 10) / 10 : null,\n    kelembapan: sensorOk ? Math.round(p.kelembapan * 10) / 10 : null,\n    vbat: Number(p.vbat),\n    rssi: Number(p.rssi),\n    seq,\n    pdr: Math.round(s.diterima / (s.last - s.first + 1) * 1000) / 10,\n    sensorOk,\n    waktu: Date.now(),\n};\nnode.status({ fill: 'green', shape: 'dot', text: RUANG[id] + ' seq ' + seq });\nreturn msg;",
